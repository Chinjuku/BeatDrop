{
  "name": "beatdrop-nextjs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "BeatDrop Fullstack (Next.js App Router + Supabase PostgreSQL on Vercel)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test tests/*.test.ts && npm run -s test:verify",
    "test:verify": "npm run -s test:pwa && npm run -s test:consent && npm run -s test:daily && npm run -s test:daily-client && npm run -s test:guesser && npm run -s test:share && npm run -s test:autocomplete && npm run -s test:audio-network && npm run -s test:data-saver && npm run -s test:low-power && npm run -s test:bluetooth && npm run -s test:proxy && npm run -s test:edge-proxy && npm run -s test:i18n",
    "test:pwa": "tsx scripts/verify-pwa.ts",
    "test:consent": "node --import tsx/esm scripts/verify-consent.ts",
    "test:daily": "node --import tsx/esm scripts/verify-daily-challenge.ts",
    "test:daily-client": "node --import tsx/esm scripts/verify-daily-client.ts",
    "test:guesser": "node --import tsx/esm scripts/verify-guesser.ts",
    "test:share": "node --import tsx/esm scripts/verify-share-utils.ts",
    "test:autocomplete": "node --import tsx/esm scripts/verify-autocomplete-network.ts",
    "test:audio-network": "node --import tsx/esm scripts/verify-audio-network-recovery.ts",
    "test:data-saver": "node --import tsx/esm scripts/verify-data-saver.ts",
    "test:low-power": "node --import tsx/esm scripts/verify-low-power-audio.ts",
    "test:bluetooth": "node --import tsx/esm scripts/verify-bluetooth-latency.ts",
    "test:proxy": "node --import tsx/esm scripts/verify-audio-proxy.ts",
    "test:edge-proxy": "node --import tsx/esm scripts/verify-edge-proxy.ts",
    "migrate:supabase": "tsx scripts/migrate-to-supabase.ts",
    "test:i18n": "node --import tsx/esm scripts/verify-i18n.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "lucide-react": "^1.16.0",
    "next": "^15.2.0",
    "next-intl": "^4.15.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
