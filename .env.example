# ==============================================================================
# BeatDrop — Environment Variables (.env.local for local dev, Vercel for production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Mode: Offline SQLite vs Cloud Supabase
# ------------------------------------------------------------------------------
# - DB_LOCAL=true  : ใช้งานฐานข้อมูล SQLite ในเครื่อง (data/beatdrop.db) แบบ 100% Offline ไม่ต่อ Supabase
# - DB_LOCAL=false หรือเว้นว่างไว้ : เชื่อมต่อ Supabase PostgreSQL (Production / Cloud)
DB_LOCAL=false

# ------------------------------------------------------------------------------
# 2. Supabase Connection (จำเป็นเมื่อ DB_LOCAL=false หรือไม่ได้กำหนด DB_LOCAL)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# (ทางเลือก) PostgreSQL Pooler Connection สำหรับ Drizzle / Prisma ORM
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. Security & Stateless Tokens
# ------------------------------------------------------------------------------
# คีย์สำหรับเซ็น HMAC-SHA256 Stateless Round Token (ป้องกันโกงคำตอบและรองรับ Serverless)
ROUND_TOKEN_SECRET="replace-with-a-random-32-byte-secret-string"

# Vercel Cron Secret สำหรับยืนยันการรัน Daily Challenge อัตโนมัติทุก 00:00 น.
CRON_SECRET="replace-with-your-vercel-cron-secret"
